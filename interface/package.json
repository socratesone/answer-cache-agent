{
  "name": "questionnaire-interface",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts": "node scripts/contracts.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run contracts && tsc --noEmit && vite build && node scripts/bundle-content.mjs",
    "test": "vitest run",
    "test:host": "PYTHONPATH=companion:.. python -m pytest tests -q",
    "check": "npm run build && npm test && npm run test:host",
    "package:store": "node scripts/store.mjs",
    "format": "prettier --write src scripts/*.mjs *.html *.json vite.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "json-schema-to-typescript": "^15.0.3",
    "prettier": "^3.6.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
