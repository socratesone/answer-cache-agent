{
  "$defs": {
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "max_length": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "max_words": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Words"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "title": "Constraints",
      "type": "object"
    },
    "Hint": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "source": {
          "default": "caller",
          "enum": [
            "caller",
            "rule",
            "user"
          ],
          "title": "Source",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "value"
      ],
      "title": "Hint",
      "type": "object"
    },
    "HintRule": {
      "additionalProperties": false,
      "description": "User-maintained deterministic rule: regex over a page field assigns a value (Q2).",
      "properties": {
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "match_field": {
          "enum": [
            "page_url",
            "page_title",
            "question_text"
          ],
          "title": "Match Field",
          "type": "string"
        },
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "id",
        "match_field",
        "pattern",
        "dimension",
        "value"
      ],
      "title": "HintRule",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "constraints": {
          "$ref": "#/$defs/Constraints",
          "default": {
            "max_length": null,
            "max_words": null,
            "required": false
          }
        },
        "hints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Hint"
          },
          "title": "Hints",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "prefilled": {
          "default": false,
          "title": "Prefilled",
          "type": "boolean"
        },
        "prefilled_template_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefilled Template Ref"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Question",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "hints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Hint"
      },
      "title": "Hints",
      "type": "array"
    },
    "page_context": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Sanitized, disclosure-approved page text only.",
      "title": "Page Context"
    },
    "page_title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Title"
    },
    "page_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Url"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/Question"
      },
      "title": "Questions",
      "type": "array"
    },
    "rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/HintRule"
      },
      "title": "Rules",
      "type": "array"
    }
  },
  "required": [
    "questions"
  ],
  "title": "PrepareFormPayload",
  "type": "object"
}
